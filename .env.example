# Required: lead delivery to Google Sheets (server only).
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
GOOGLE_CLIENT_EMAIL=
# Paste the private_key value from the service account JSON, keeping its escaped newlines.
GOOGLE_PRIVATE_KEY=""

# Optional: an email notification after the lead is saved to Sheets.
# Keep credentials on the server; never place them in assets/scripts/.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
PORT=3000
